# Адрес Strapi (без слеша в конце).
# Локально: http://localhost:1337
# Prod:     http://176.53.160.167:3002
STRAPI_URL=

# Базовый URL сайта — используется для metadataBase (og:image, twitter:image).
# Локально: http://localhost:3000
# Prod:     http://176.53.160.167:3001
NEXT_PUBLIC_SITE_URL=

# API-токен Strapi с правами read-only на нужные коллекции.
# Опционально: если открыты Public-права на find/findOne, токен не нужен.
STRAPI_TOKEN=

# Meilisearch (читаем индексы, которые наполняет Strapi).
# host без слеша на конце; локально совпадает с docker-compose из корня репо.
# Ключ — серверный (на клиент не утекает): можно master, либо завести
# scoped search-key через Meili API.
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=
