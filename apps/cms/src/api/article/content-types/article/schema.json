{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Новости портала"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "string",
      "unique": true,
      "maxLength": 280
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "maxLength": 280
    },
    "body": {
      "type": "richtext"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "coverAlt": {
      "type": "string",
      "maxLength": 200
    },
    "readingTime": {
      "type": "integer",
      "min": 1
    },
    "isLead": {
      "type": "boolean",
      "default": false
    }
  }
}
