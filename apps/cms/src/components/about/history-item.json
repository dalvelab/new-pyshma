{
  "collectionName": "components_about_history_items",
  "info": {
    "displayName": "History Item",
    "icon": "clock",
    "description": "Карточка блока «история» и отдельная страница /about/history/<slug>"
  },
  "options": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "regex": "^[a-z0-9-]+$",
      "maxLength": 80,
      "description": "Адрес страницы: /about/history/<slug>, латиница и дефисы"
    },
    "year": {
      "type": "string",
      "required": true,
      "maxLength": 20,
      "description": "Крупный заголовок отдельной страницы, например «2025»"
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "description": "Заголовок карточки"
    },
    "body": {
      "type": "richtext",
      "required": true,
      "description": "Markdown-текст отдельной страницы"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Фото карточки; если не задано — показывается узор с иллюстрацией"
    },
    "pattern": {
      "type": "enumeration",
      "enum": ["diag", "dots", "cross", "warm", "block", "sun", "zigzag"],
      "default": "cross",
      "description": "Узор плейсхолдера (когда нет фото)"
    },
    "illustration": {
      "type": "enumeration",
      "enum": ["city", "park", "pond", "stage", "crowd", "portrait", "building", "sport", "leaf", "sun", "abstract"],
      "default": "building",
      "description": "Иллюстрация плейсхолдера (когда нет фото)"
    }
  }
}
