{
  "collectionName": "components_about_history_items",
  "info": {
    "displayName": "History Item",
    "icon": "clock",
    "description": "Карточка блока «история» и отдельная страница /about/history/<slug>"
  },
  "options": {},
  "attributes": {
    "slug": {
      "type": "string",
      "maxLength": 80,
      "description": "Заполняется автоматически из заголовка (транслит). Адрес: /about/history/<slug>"
    },
    "year": {
      "type": "string",
      "required": true,
      "maxLength": 20,
      "description": "Крупный заголовок отдельной страницы, например «2025»"
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "description": "Заголовок карточки"
    },
    "body": {
      "type": "richtext",
      "required": true,
      "description": "Markdown-текст отдельной страницы"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Фото карточки; если не задано — показывается узор с иллюстрацией"
    }
  }
}
